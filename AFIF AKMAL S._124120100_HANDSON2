# File 1: konversi.py

def c_to_f(c):
    return (c * 9/5) + 32

def f_to_c(f):
    return (f - 32) * 5/9

# File 2: main.py

c = float(input("Masukkan suhu Celcius: "))

print("Suhu dalam Fahrenheit =", c_to_f(c))

f = float(input("Masukkan suhu Fahrenheit: "))

print("Suhu dalam Celcius =", f_to_c(f))
